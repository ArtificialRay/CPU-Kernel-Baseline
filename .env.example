# Copy to .env and fill in.

# litellm / OpenAI-compatible provider credentials. Used directly by
# eval/evaluator.py's litellm agent loop (--harness own), and optionally by
# --harness codex (CodexAdapter builds a custom model_providers entry from
# these — leave OPENAI_API_KEY empty to keep using whatever account
# `codex login` already set up instead). --harness nanobot does NOT read
# these; see NANOBOT_CONFIG_BASE below.
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_BASE_URL=

# --harness claude-code reads these two directly (no repo code touches
# them) — only needed if you want claude-code pointed at something other
# than whatever account `claude login` already set up. See also
# CLAUDE_CODE_USE_BEDROCK/CLAUDE_CODE_USE_VERTEX for those backends.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Optional. Overrides the nanobot base config test_scripts/harness_adapters.py
# reads (defaults to skills/nanobot/nanobot-kernel-session/config.json).
# --harness nanobot's model/provider/API key live in THAT file, not in this
# .env — OPENAI_API_KEY/OPENAI_API_BASE above have no effect on nanobot.
NANOBOT_CONFIG_BASE=

# Repo-root-relative paths rsync'd to the remote instance before a session
# starts (comma-separated). 
RSYNC_ALLOWLIST=bench,bench-trace/definitions,bench-trace/solutions,bench-trace/workloads,bench-trace/tensors,mcp_app,requirements.txt,contracts.py,config
