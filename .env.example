# Copy to .env and fill in.

# litellm / OpenAI-compatible provider credentials (used by eval/evaluator.py's
# litellm agent loop, --harness own).
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_BASE_URL=

# Optional. Overrides the nanobot base config test_scripts/harness_adapters.py
# reads (defaults to skills/nanobot/nanobot-kernel-session/config.json).
NANOBOT_CONFIG_BASE=
