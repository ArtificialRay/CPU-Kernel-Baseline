# Optional one-off overrides; a fresh checkout runs without a .env.
# A value set here wins over the persistent config file (see README "Configuration").

# nanobot base config (default: skills/nanobot/nanobot-kernel-session/config.json)
# NANOBOT_CONFIG_BASE=

# repo paths to rsync, comma-separated (default: config/rsync_allowlist.json)
# RSYNC_ALLOWLIST=

# OpenAI-compatible endpoint: overrides the codex / cline config.json
# OPENAI_API_KEY=
# OPENAI_API_BASE=

# claude-code (only to use something other than `claude login`)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# own harness: persistent scratchpad tool (=1)
# ARMBENCH_NOTEPAD=

# local bench/ harness: existing ncnn / llama.cpp checkouts
# NCNN_ROOT=
# LLAMA_CPP_ROOT=
